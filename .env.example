# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.

# --- Firebase (login e biblioteca) — Console do Firebase > Configurações do projeto > Seus apps > Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Vercel Blob (anexos) — Vercel > Storage > Create > Blob (acesso Private) > Connect to project.
# Na Vercel a variável é criada sozinha; para rodar local, copie o token para cá.
# Chave secreta: só no servidor, nunca com prefixo VITE_
BLOB_READ_WRITE_TOKEN=

# --- Gemini (resumos e busca) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional
# GEMINI_MODEL=gemini-3.8-flash
# AI_DAILY_LIMIT=50
# Modelos reserva, separados por vírgula (usados se o principal estiver fora do ar)
# GEMINI_FALLBACK_MODELS=
