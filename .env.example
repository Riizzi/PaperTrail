# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.

# --- Firebase (login e biblioteca) — Console do Firebase > Configurações do projeto > Seus apps > Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Supabase (anexos) — Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=  # chave anon (antiga) ou publishable (sb_publishable_...)
# Chave secreta: só no servidor, nunca com prefixo VITE_
SUPABASE_SERVICE_ROLE_KEY=  # service_role (antiga) ou secret (sb_secret_...)

# --- Gemini (resumos e busca) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional
# GEMINI_MODEL=gemini-3.8-flash
# AI_DAILY_LIMIT=50
